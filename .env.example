# Copia este archivo a ".env" y ajusta los valores antes de ejecutar
# "docker compose up -d --build".
#
# En producción, cambia obligatoriamente POSTGRES_PASSWORD, JWT_SECRET_KEY y
# BOOTSTRAP_ADMIN_PASSWORD por valores propios y seguros.

# ---------- PostgreSQL ----------
POSTGRES_DB=DermaImage
POSTGRES_USER=root
POSTGRES_PASSWORD=root1234

# ---------- Puertos publicados en el host ----------
WEB_PORT=5130
API_PORT=5131
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025

# ---------- JWT ----------
# Cadena aleatoria de al menos 32 caracteres. Puedes generar una con:
#   openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=DermaUH-API
JWT_AUDIENCE=DermaUH-Web
JWT_EXPIRY_MINUTES=1440

# ---------- Administrador inicial ----------
# Si se definen correo y contraseña, la API crea (o promueve) esta cuenta como
# Admin al arrancar. Es la única forma de tener un primer administrador en una
# base de datos vacía. La contraseña debe tener 8+ caracteres, mayúscula,
# minúscula y número. Tras el primer arranque puede dejarse en blanco.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=DermaUH

# ---------- URLs públicas ----------
# Dirección desde la que los usuarios acceden al sitio. Se usa para construir
# los enlaces de confirmación de correo y de restablecimiento de contraseña.
FRONTEND_BASE_URL=http://localhost:5130

# ---------- Autenticación con Google (opcional) ----------
GOOGLE_CLIENT_ID=

# ---------- Correo saliente (SMTP) ----------
# Sin SMTP los correos no se envían (solo se registran en el log de la API), y
# los usuarios que se registren no podrán confirmar su correo.
# Para pruebas locales: docker compose --profile mail up -d y usar
#   SMTP_SERVER_ADDRESS=mailpit  SMTP_SERVER_PORT=1025
SMTP_SERVER_ADDRESS=
SMTP_SERVER_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false
SMTP_FROM_ADDRESS=noreply@dermauh.cu
SMTP_FROM_DISPLAY_NAME=DermaUH Images
SMTP_SUBJECT_PREFIX=

# ---------- Entorno ASP.NET ----------
ASPNETCORE_ENVIRONMENT=Production
